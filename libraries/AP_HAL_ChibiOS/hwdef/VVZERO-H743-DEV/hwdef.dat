# hw definition file for processing by chibios_pins.py

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID for firmware load
APJ_BOARD_ID AP_HW_VVZERO-H743-DEV

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 25000000

FLASH_SIZE_KB 2048
env OPTIMIZE -Os

USB_STRING_MANUFACTURER "VVZERO"

# bootloader takes first sector
FLASH_RESERVE_START_KB 128

# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SPI1 for IMU
PA4 IMU_CS CS
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1

# two I2C bus
I2C_ORDER I2C1 I2C4

# I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C4
PB8 I2C4_SCL I2C4
PB9 I2C4_SDA I2C4

# ADC
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC4 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_PIN 4
define HAL_BATT_CURR_SCALE 40.0

# LED
PB4 LED0 OUTPUT LOW GPIO(90)
PA15 LED1 OUTPUT LOW GPIO(91)
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

define HAL_GPIO_LED_ON 1
define AP_NOTIFY_GPIO_LED_2_ENABLED 1

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4

# USART1
PB15 USART1_RX USART1
PB14 USART1_TX USART1

# USART2
PA2 USART2_TX USART2
PA3 USART2_RX USART2

# USART3
PD9 USART3_RX USART3
PD8 USART3_TX USART3

# UART4
PD1 UART4_TX UART4
PD0 UART4_RX UART4

# microSD support
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

# Motors
PE9  TIM1_CH1  TIM1  PWM(1)  GPIO(50)
PE11 TIM1_CH2  TIM1  PWM(2)  GPIO(51)
PE13 TIM1_CH3  TIM1  PWM(3)  GPIO(52)
PE14 TIM1_CH4  TIM1  PWM(4)  GPIO(53)
PA0  TIM2_CH1  TIM2  PWM(5)  GPIO(54)
PA1  TIM2_CH2  TIM2  PWM(6)  GPIO(55)

DMA_PRIORITY S*

define HAL_STORAGE_SIZE 32768

# use last 2 pages for flash storage
# H743 has 16 pages of 128k each
STORAGE_FLASH_PAGE 14

# spi devices
SPIDEV icm42688 SPI1 DEVID1 IMU_CS MODE3 400*KHZ 400*KHZ

DMA_NOSHARE SPI1*

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define ALLOW_ARM_NO_COMPASS
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# IMUs
IMU Invensensev3 SPI:icm42688 ROTATION_YAW_90
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# BAROs
BARO SPL06 I2C:0:0x77

define HAL_OS_FATFS_IO 1
