# hw definition file for processing by chibios_pins.py
# for AET H743-Basic

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID for firmware load
APJ_BOARD_ID AP_HW_AET-H743-CH2O

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048
env OPTIMIZE -Os

USB_STRING_MANUFACTURER "AET"

# bootloader takes first sector
FLASH_RESERVE_START_KB 128

# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SPI1 for IMU1 (ICM-42688)
PA4 IMU1_CS CS
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1

# SPI2 for MAX7456 OSD
PB12 MAX7456_CS CS
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2

# SPI3 for flash
PD7 FLASH_CS CS
PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3

# SPI4 for IMU2 (ICM-42688)
PE11 IMU2_CS CS
PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4

# two I2C bus
I2C_ORDER I2C1 I2C2

# I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C2
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# ADC
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)
PC4 BATT2_VOLTAGE_SENS ADC1 SCALE(1)
PB0 BATT2_CURRENT_SENS ADC1 SCALE(1)

# INA226 battery monitor
define HAL_BATTMON_INA2XX_BUS 1
define HAL_BATTMON_INA2XX_ADDR 0x40
define HAL_BATT_MONITOR_DEFAULT 21

# Also support analog battery monitor
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
define HAL_BATT2_VOLT_PIN 4
define HAL_BATT2_CURR_PIN 9
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 40.0
define HAL_BATT2_VOLT_SCALE 11.0

PC5 RSSI_ADC ADC1
define BOARD_RSSI_ANA_PIN 8

# LED
define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1
PE2 LED_RED OUTPUT GPIO(10)
PE3 LED_GREEN OUTPUT GPIO(11)
PE4 LED_BLUE OUTPUT GPIO(12)

define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 10
define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 11
define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 12

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5

# USART1
PA10 USART1_RX USART1
PA9  USART1_TX USART1

# USART2
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# USART3
PD9 USART3_RX USART3
PD8 USART3_TX USART3

# UART4
PB9 UART4_TX UART4
PB8 UART4_RX UART4

# UART5
PC12 UART5_TX UART5
PD2  UART5_RX UART5

# Serial functions
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_RCIN

# CAN bus
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
PD3 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)

# Motors
PC6  TIM8_CH1  TIM8  PWM(1)  GPIO(50)
PC7  TIM3_CH2  TIM3  PWM(2)  GPIO(51)
PC8  TIM3_CH3  TIM3  PWM(3)  GPIO(52)
PD12 TIM4_CH1  TIM4  PWM(4)  GPIO(53)
PD13 TIM4_CH2  TIM4  PWM(5)  GPIO(54)
PD14 TIM4_CH3  TIM4  PWM(6)  GPIO(55)
PA0  TIM5_CH1  TIM5  PWM(7)  GPIO(56)
PA1  TIM5_CH2  TIM5  PWM(8)  GPIO(57)
PA2  TIM5_CH3  TIM5  PWM(9)  GPIO(58)
PA3  TIM5_CH4  TIM5  PWM(10) GPIO(59)
PA8  TIM1_CH1  TIM1  PWM(11) GPIO(60) # for WS2812 LED

# Beeper
PA15 TIM2_CH1  TIM2  GPIO(32) ALARM

# GPIOs
PD11  PINIO1 OUTPUT GPIO(81) LOW

DMA_PRIORITY S*

define HAL_STORAGE_SIZE 32768

# use last 2 pages for flash storage
# H743 has 16 pages of 128k each
STORAGE_FLASH_PAGE 14

# spi devices
SPIDEV icm42688_0  SPI1 DEVID1 IMU1_CS      MODE3  2*MHZ 16*MHZ   # Clock is 100Mhz so highest clock <= 24Mhz is 100Mhz/8
SPIDEV icm42688_1  SPI4 DEVID1 IMU2_CS      MODE3  2*MHZ 16*MHZ
SPIDEV osd         SPI2 DEVID4 MAX7456_CS   MODE0 10*MHZ 10*MHZ
SPIDEV sdcard      SPI3 DEVID3 FLASH_CS     MODE0 400*KHZ 25*MHZ


DMA_NOSHARE SPI1* SPI4*

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define ALLOW_ARM_NO_COMPASS
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# two IMUs
# ICM42688P, ICM42688P
IMU Invensensev3 SPI:icm42688_0 ROTATION_YAW_90
IMU Invensensev3 SPI:icm42688_1 ROTATION_YAW_180
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# BAROs
BARO SPL06  I2C:1:0x76

define HAL_OS_FATFS_IO 1

# setup for OSD
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin
