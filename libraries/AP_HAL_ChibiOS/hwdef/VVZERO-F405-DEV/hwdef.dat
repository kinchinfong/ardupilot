
# hw definition file for processing by chibios_hwdef.py

# MCU class and specific type
MCU STM32F4xx STM32F405xx

# board ID for firmware load
APJ_BOARD_ID AP_HW_VVZERO-F405-DEV

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 1024

# bootloader takes first sector
FLASH_RESERVE_START_KB 48

define HAL_STORAGE_SIZE 16384
define STORAGE_FLASH_PAGE 1

# SPI devices

# SPI1
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PA4 IMU_CS CS

# SERIAL ports
# USART1 as SERIAL0 (console) for DEV_PRINTF debug output
SERIAL_ORDER USART1 OTG1 EMPTY USART3 UART4
define SERIAL0_BAUD 115200
# Use Console protocol on SERIAL0 (no MAVLink), use SERIAL1 (USB) for MAVLink
# 0 = SerialProtocol_Console (debug output only, no MAVLink binary data)
define DEFAULT_SERIAL0_PROTOCOL 0
define DEFAULT_SERIAL1_PROTOCOL 2
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# USART1
PA10 USART1_RX USART1
PA9 USART1_TX USART1

# USART3
PB10 USART3_TX USART3
PB11 USART3_RX USART3

# UART4
PC10 UART4_TX UART4
PC11 UART4_RX UART4

# I2C ports
I2C_ORDER I2C1
# I2C1
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

# ADC ports

# ADC1
PA1 BATT_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 1
define HAL_BATT_VOLT_SCALE 11.0
PA2 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_CURR_PIN 2
define HAL_BATT_CURR_SCALE 40.0
define HAL_BATT_MONITOR_DEFAULT 4

# MOTORS
PB6 TIM4_CH1 TIM4 PWM(1) GPIO(50)
PB7 TIM4_CH2 TIM4 PWM(2) GPIO(51)
PB1 TIM3_CH4 TIM3 PWM(3) GPIO(52)
PB0 TIM3_CH3 TIM3 PWM(4) GPIO(53)

# LED
PA8 LED0 OUTPUT LOW GPIO(90)
PD2 LED1 OUTPUT LOW GPIO(91)
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

define AP_NOTIFY_GPIO_LED_2_ENABLED 1

# Barometer setup
BARO SPL06 I2C:0:0x77

# IMU setup
# SC7U22 requires SPI MODE0 (CPOL=0, CPHA=0)
SPIDEV imu1 SPI1 DEVID1 IMU_CS MODE0 1*MHZ 8*MHZ

IMU SC7U22 SPI:imu1 ROTATION_PITCH_180
DMA_PRIORITY TIM4* TIM3* SPI1*

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define ALLOW_ARM_NO_COMPASS
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2
define HAL_DEFAULT_INS_FAST_SAMPLE 3

include ../include/minimize_features.inc
